<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/configFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/windowBackground"
        tools:context=".ui.ConfigFragment">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/config_fragment_bar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:background="?attr/colorPrimary"
            android:minHeight="?attr/actionBarSize"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:title="@string/nav_menu_title_config"
            app:titleCentered="true"
            app:titleTextColor="?attr/colorOnPrimary" />

        <ScrollView
            android:id="@+id/scrollView3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@+id/bottomButtonsLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/config_fragment_bar">

            <LinearLayout
                android:id="@+id/scrollLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <!-- 1. Callsign & Grid -->
                <TextView style="@style/TextAppearance.Material3.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mycall" android:textColor="?attr/colorPrimary" android:layout_marginTop="8dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/myCallLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/mycall" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@+id/modifierLayout" app:layout_constraintTop_toTopOf="parent" app:layout_constraintHorizontal_weight="1">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputMycallEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters" android:textSize="14sp" android:paddingVertical="10dp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/modifierLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense" android:layout_width="100dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:hint="@string/sequence" app:layout_constraintStart_toEndOf="@+id/myCallLayout" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/modifierEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters" android:textSize="14sp" android:paddingVertical="10dp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/gridLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/headGrid" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@+id/configGetGridImageButton" app:layout_constraintTop_toTopOf="parent">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputMyGridEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters" android:textSize="14sp" android:paddingVertical="10dp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <ImageButton android:id="@+id/configGetGridImageButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_baseline_not_listed_location_32" app:tint="?android:attr/textColorSecondary" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" />

                <!-- 2. Transmit -->
                <TextView style="@style/TextAppearance.Material3.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/launch" android:textColor="?attr/colorPrimary" />
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/freqLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/sendDefaultFreq" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@+id/synFrequencySwitch" app:layout_constraintTop_toTopOf="parent" app:layout_constraintHorizontal_weight="1">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputFreqEditor" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:textSize="14sp" android:paddingVertical="10dp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/synFrequencySwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/synFrequency" android:textSize="12sp" app:layout_constraintStart_toEndOf="@+id/freqLayout" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/tran_delay">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputTransDelayEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:textSize="14sp" android:paddingVertical="10dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" />

                <!-- 3. Time -->
                <TextView style="@style/TextAppearance.Material3.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/timeOffset" android:textColor="?attr/colorPrimary" />
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/utcLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/timeOffset" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@+id/synTImeButton" app:layout_constraintTop_toTopOf="parent" app:layout_constraintHorizontal_weight="1">
                        <AutoCompleteTextView android:id="@+id/utcTimeOffsetSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textSize="14sp" android:paddingVertical="10dp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/synTImeButton" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/config_Syn_time" android:textSize="11sp" app:layout_constraintStart_toEndOf="@+id/utcLayout" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/ptt_delay">
                    <AutoCompleteTextView android:id="@+id/pttDelayOffsetSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textSize="14sp" android:paddingVertical="10dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" />

                <!-- 4. Radio Connect -->
                <TextView style="@style/TextAppearance.Material3.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rig_name" android:textColor="?attr/colorPrimary" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:hint="@string/rig_name">
                    <AutoCompleteTextView android:id="@+id/rigNameSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textSize="14sp" android:paddingVertical="10dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/operationBand">
                    <AutoCompleteTextView android:id="@+id/operationBandSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textSize="14sp" android:paddingVertical="10dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.bg7yoz.ft8cn.ui.RadioGroupFt8cn android:id="@+id/controlRadioGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                    <RadioButton android:id="@+id/voxRadioButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/VOX" android:textSize="12sp" android:minHeight="48dp"/>
                    <RadioButton android:id="@+id/catRadioButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/CAT" android:textSize="12sp" android:minHeight="48dp"/>
                    <RadioButton android:id="@+id/rtsRadioButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/RTS" android:textSize="12sp" android:minHeight="48dp"/>
                    <RadioButton android:id="@+id/dtrRadioButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/DTR" android:textSize="12sp" android:minHeight="48dp"/>
                </com.bg7yoz.ft8cn.ui.RadioGroupFt8cn>

                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/bau_rate">
                    <AutoCompleteTextView android:id="@+id/baudRateSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textSize="14sp" android:paddingVertical="10dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:baselineAligned="false">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/serial_data_bits">
                        <AutoCompleteTextView android:id="@+id/dataBitsSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textSize="14sp" android:paddingVertical="10dp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:layout_marginStart="6dp" android:hint="@string/serial_parity">
                        <AutoCompleteTextView android:id="@+id/parityBitsSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textSize="14sp" android:paddingVertical="10dp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:hint="@string/serial_stop_bits">
                        <AutoCompleteTextView android:id="@+id/stopBitsSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textSize="14sp" android:paddingVertical="10dp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/civLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/civ_address" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@+id/serialDefaultButton" app:layout_constraintTop_toTopOf="parent">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/civAddressEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textSize="14sp" android:paddingVertical="10dp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/serialDefaultButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/serial_default" android:textSize="11sp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" />

                <!-- 5. Automation -->
                <TextView style="@style/TextAppearance.Material3.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/launch_supervision" android:textColor="?attr/colorPrimary" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:hint="@string/launch_supervision">
                    <AutoCompleteTextView android:id="@+id/launchSupervisionSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textSize="14sp" android:paddingVertical="10dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/no_response_count">
                    <AutoCompleteTextView android:id="@+id/noResponseCountSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textSize="14sp" android:paddingVertical="10dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/followCQSwitch" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/follow_cq" android:textSize="14sp" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/autoCallfollowSwitch" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/auto_call_follow" android:textSize="14sp" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/saveSWLSwitch" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/config_save_swl" android:textSize="14sp" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/saveSWLQSOSwitch" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/config_save_swl_qso" android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" />

                <!-- 6. Cloud Services -->
                <TextView style="@style/TextAppearance.Material3.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cloudlog_settings" android:textColor="?attr/colorPrimary" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/enableCloudlogSwitch" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/config_enable_cloudlog" android:textSize="14sp" />
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/cloudlog_addr" android:layout_marginTop="4dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/cloudlogServerAddressEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:paddingVertical="10dp"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/cloudlog_api_key">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/cloudlogServerApiKeyEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:paddingVertical="10dp"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/cloudlog_station_id">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/cloudlogStationIdEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:paddingVertical="10dp"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/testCloudlogButton" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/test_cloudlog_config" android:textSize="12sp" />

                <TextView style="@style/TextAppearance.Material3.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/qrz_settings" android:textColor="?attr/colorPrimary" android:layout_marginTop="16dp"/>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/enableQrzSwitch" android:layout_width="match_parent" android:layout_height="44dp" android:text="@string/config_enable_qrz" android:textSize="14sp" />
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:hint="@string/qrz_api_key">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/qrzApiKeyTextEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:paddingVertical="10dp"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/testQrzButton" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/test" android:textSize="12sp" />

                <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" />

                <!-- 7. Advanced -->
                <TextView style="@style/TextAppearance.Material3.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cache_clear_title" android:textColor="?attr/colorPrimary" />
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/be_excluded_callsigns" android:layout_marginTop="4dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/excludedCallsignEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:paddingVertical="10dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:layout_marginTop="12dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/clearFollowButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="@string/maidenhead_help" android:textSize="11sp" android:gravity="start|center_vertical" android:minHeight="48dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/clearLogCacheButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="@string/config_save_swl" android:textSize="11sp" android:gravity="start|center_vertical" android:minHeight="48dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/clearSWlQsoButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="@string/config_clear_swl_qso" android:textSize="11sp" android:gravity="start|center_vertical" android:minHeight="48dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/clearShareDataButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="@string/config_clear_share_data" android:textSize="11sp" android:gravity="start|center_vertical" android:minHeight="48dp" />
                </GridLayout>

                <!-- 8. Summary Info -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant">
                    <TextView
                        android:id="@+id/configSummaryIntro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:lineSpacingExtra="4dp"
                        android:text="配置简介：\n• 请输入您的呼号与网格位置以便进行 FT8 通联。\n• 时间同步对解码至关重要，建议定期使用 NTP 校时。\n• 电台连接支持 VOX、CAT 及串口 PTT 控制方式。\n• 自动化选项可帮助您快速关注与回复呼号。"/>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/bottomButtonsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/aboutButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_me"
                android:textSize="12sp"
                android:minHeight="48dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/faqButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
